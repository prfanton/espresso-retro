# Supabase project — Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile CAPTCHA on anonymous sign-in (abuse protection).
# Enable CAPTCHA in Supabase (Authentication → Attack Protection → Turnstile),
# paste the Turnstile *secret* key there, and put the matching *site* key here.
# Leave blank to disable the challenge entirely.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
